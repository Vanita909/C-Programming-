SELECT deptno,
  2         COUNT(empno) AS total_employee,
  3         SUM(sal) AS total_salary
  4  FROM emp
  5  GROUP BY CUBE(deptno)
  6  ORDER BY deptno;

    DEPTNO TOTAL_EMPLOYEE TOTAL_SALARY                                                                                                                
---------- -------------- ------------                                                                                                                
        10              3         8750                                                                                                                
        20              5        10875                                                                                                                
        30              6         9400                                                                                                                
                       14        29025                                                                                                                

