SQL> CREATE TABLE Student_Master (
  2      Sno NUMBER PRIMARY KEY,
  3      Sname VARCHAR2(30),
  4      C_code NUMBER,
  5      City VARCHAR2(30),
  6      Age NUMBER,
  7      FOREIGN KEY (C_code) REFERENCES Course_master(C_code)
  8  );

Table created.

