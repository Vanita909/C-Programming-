SQL> --iii)
SQL> SELECT c.com_name,
  2         AVG(i.price) AS average_price
  3  FROM Company_master_new c
  4  JOIN Item_Master_new i
  5  ON c.Com_id = i.company_code
  6  GROUP BY c.com_name;

COM_NAME                       AVERAGE_PRICE                                                                                                                                                            
------------------------------ -------------                                                                                                                                                            
Samsung                                  400                                                                                                                                                            
Apple                                    700                                                                                                                                                            
Dell                                     500                                                                                                                                                            
HP                                       300                                                                                                                                                            

SQL> --iv)
SQL> SELECT c.com_name,
  2         AVG(i.price) AS average_price
  3  FROM Company_master_new c
  4  JOIN Item_Master_new i
  5  ON c.Com_id = i.company_code
  6  GROUP BY c.com_name
  7  HAVING AVG(i.price) >= 350;

COM_NAME                       AVERAGE_PRICE                                                                                                                                                            
------------------------------ -------------                                                                                                                                                            
Samsung                                  400                                                                                                                                                            
Apple                                    700                                                                                                                                                            
Dell                                     500                                                                                                                                                            

