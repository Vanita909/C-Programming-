SQL> CREATE TABLE Company_master_new (
  2      Com_id NUMBER(5) PRIMARY KEY,
  3      com_name VARCHAR2(30)
  4  );

Table created.

SQL> CREATE TABLE Item_Master_new (
  2      Item_id NUMBER(5) PRIMARY KEY,
  3      Item_name VARCHAR2(30),
  4      price NUMBER(10,2),
  5      company_code NUMBER(5),
  6      FOREIGN KEY (company_code) REFERENCES Company_master_new(Com_id)
  7  );

