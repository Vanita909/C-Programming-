SQL> SELECT e.emp_name,
  2         d.dept_name,
  3         s.sal + s.hra + s.ma - s.pf AS total_salary
  4  FROM Emp_mast e
  5  JOIN Dept_mast d
  6  ON e.dept_code = d.dept_no
